# Настройки сборки DVChat. Скопируйте в dvchat.env и заполните:  cp dvchat.env.example dvchat.env
# Файл dvchat.env в репозиторий не попадает (он в .gitignore). Подключение: --dart-define-from-file=dvchat.env

# Адрес вашего сервера Matrix (Synapse) без https://
DVCHAT_HOMESERVER=chat.example.org

# Адрес шлюза уведомлений Matrix (его получает Synapse при регистрации push)
DVCHAT_PUSH_GATEWAY=https://push.example.org/_matrix/push/v1/notify

# Канал обновлений (по желанию): адрес с секретной частью, оканчивается на /. Пусто: обновления отключены
DVCHAT_UPDATE_URL=

# Подтверждение входа в другие сервисы (DV Auth, github.com/Godween69/DVAuth) по QR и числу.
# Публичный адрес сервиса без / на конце. Пусто: пункт в настройках покажет, что функция выключена
DVCHAT_AUTH_URL=
